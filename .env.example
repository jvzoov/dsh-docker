# Compose-only settings. Provider URL and credentials live under config/.
# Render nginx/dsh.conf.example with scripts/render-nginx-conf.sh after
# changing DSH_PORT or the public authority.

# Host port for the DSH Web UI, published to 127.0.0.1. It also feeds DSH's
# local trust fence and the startup URL display.
DSH_PORT=3080

# Public URL used only to print a copyable official DSH startup URL.
# DSH_PUBLIC_URL=https://dsh.example.com

# Hostname accepted by DSH's browser-trust fence. A port-less hostname works
# with any public HTTPS port.
# DSH_TRUSTED_HOST=dsh.example.com

# Optional. Host directory mounted as the agent workspace at /home/node.
# Defaults to ./workspace next to this file; uncomment to use a custom path.
# The directory must be readable/writable by uid 1000 (the container's node
# user).
# DSH_WORKSPACE=/path/to/workspace
