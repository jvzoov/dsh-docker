# DeepSeek Harness — reverse proxy using DSH's official browser authentication.
#
# DSH prints a one-time tokenized root URL at startup. Open that URL through
# this proxy; DSH exchanges the token for an authority-bound session cookie,
# then authenticates every API and WebSocket request with that cookie.
#
# The proxy does not implement a second login service. It preserves the public
# Host and Origin so DSH's trusted-host fence and cookie authority agree.
#
# The DSH backend port is centralized below and mirrors DSH_PORT from .env.
# Render from .env with:
#   ./scripts/render-nginx-conf.sh | sudo tee /etc/nginx/sites-available/dsh.conf
#
# Before reloading, set `server_name`, TLS certificate paths, and the HTTPS
# listener. The file below starts as a plain-HTTP baseline.
# Requires nginx >= 1.5.4 with WebSocket proxy support.

server {
    listen 80;
    server_name dsh.example.com;

    # ---- Port: the only port literal in this file ------------------------
    # Keep in sync with DSH_PORT; render-nginx-conf.sh rewrites this line.
    set $dsh_backend 127.0.0.1:3080;   # .env DSH_PORT

    location / {
        proxy_pass http://$dsh_backend;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 3600s;

        # Official DSH browser authentication binds its session cookie to this
        # authority. Keep Host and Origin identical to the public request.
        proxy_set_header Host $http_host;
        proxy_set_header Origin $scheme://$http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
